# CKBolt hub configuration. Copy to .env and adjust. Every variable is validated at start-up (src/config/hub.config.ts).

# --- HTTP server
HUB_HOST=127.0.0.1
HUB_PORT=8787
HUB_CORS_ORIGINS=http://localhost:8080
# true: count clients by the last X-Forwarded-For entry of requests that come from a loopback or private address (the
# web app's proxy, with its TRUST_PROXY=1). HUB_HOST must then be loopback or private, or 0.0.0.0 inside a container
# whose port is published on such an address only. false: every request counts as its socket address, so behind a proxy
# all visitors share one budget.
HUB_TRUST_PROXY=false
HUB_RATE_LIMIT_PER_MINUTE=120
# Most clients each rate limit tracks at once; past that it forgets the one idle the longest.
HUB_RATE_LIMIT_MAX_CLIENTS=10000
HUB_DB_PATH=./data/hub.sqlite

# --- Networks: regtest + devnet locally; signet (Mutinynet) + testnet for the public demo
BTC_NETWORK=regtest
TIMING_PROFILE=regtest
CKB_NETWORK=devnet
# The UDTs the hub serves on CKB_NETWORK (CKB is built in), as one JSON list on one line (docs/architecture.md,
# "Assets"). Per UDT: id (upper-case letters and digits), symbol, name, decimals, usdRule (usd_peg: $1; btc_parity: 1:1
# with BTC), typeScript, and cellDeps as fnn's udt_whitelist needs them ({"outPoint":{"txHash","index"},"depType"} or
# {"typeId":<script>}). Optional per UDT: feeBps, optionPremiumBps, minSats, maxSats (otherwise FEE_BPS,
# OPTION_PREMIUM_BPS, SWAP_MIN_SATS, SWAP_MAX_SATS), inboundAmount (base units of one inbound channel),
# autoAcceptAmount (what a browser node whitelists to take it; inboundAmount by default), peerChannels ({"minAmount":
# base units}: nodes may open their own channel to the hub in the UDT; FIBER_PEER_CHANNEL_COMMITMENT_DELAY_EPOCHS must
# then stay 84), displayName and iconUrl (an https URL or a small inline SVG data URL) for the web app. [] serves CKB
# only; mainnet takes no UDT. It replaces UDT_RUSD_SCRIPT, UDT_CWBTC_SCRIPT and FIBER_INBOUND_RUSD_AMOUNT: with one of
# them also set the hub refuses to start. Single quotes keep the JSON intact for Docker Compose. fnn's udt_whitelist
# (deploy/testnet/fnn/hub.yml, demo.yml) is generated from it (npm run fnn-whitelist, docs/add-token.md); fnn reads it
# only at start. Testnet example, RUSD and cWBTC:
# FIBER_ASSETS='[{"id":"RUSD","symbol":"RUSD","name":"RUSD stablecoin","decimals":8,"usdRule":"usd_peg","typeScript":{"codeHash":"0x1142755a044bf2ee358cba9f2da187ce928c91cd4dc8692ded0337efa677d21a","hashType":"type","args":"0x878fcc6f1f08d48e87bb1c3b3d5083f23f8a39c5d5c764f253b55b998526439b"},"cellDeps":[{"typeId":{"codeHash":"0x00000000000000000000000000000000000000000000000000545950455f4944","hashType":"type","args":"0x97d30b723c0b2c66e9cb8d4d0df4ab5d7222cbb00d4a9a2055ce2e5d7f0d8b0f"}}],"inboundAmount":"2000000000","autoAcceptAmount":"1000000000"},{"id":"CWBTC","symbol":"cWBTC","name":"CCH Wrapped BTC","decimals":8,"usdRule":"btc_parity","typeScript":{"codeHash":"0x25c29dc317811a6f6f3985a7a9ebc4838bd388d19d0feeecf0bcd60f6c0975bb","hashType":"type","args":"0x9a1086531ed6dc69e0bd44cef5278e03faf3015b31aff60b08fb87663ce8507100000000"},"cellDeps":[{"outPoint":{"txHash":"0xbf6fb538763efec2a70a6a3dcb7242787087e1030c4e7d86585bc63a9d337f5f","index":"0x0"},"depType":"code"}],"optionPremiumBps":0,"inboundAmount":"1000000000","autoAcceptAmount":"1000000000"}]'
# Without FIBER_ASSETS: UDT type scripts as JSON. On devnet the bootstrap prints the RUSD stand-in. On testnet RUSD
# defaults to Fiber's whitelist.
# UDT_RUSD_SCRIPT={"codeHash":"0x...","hashType":"type","args":"0x..."}
# UDT_CWBTC_SCRIPT={"codeHash":"0x...","hashType":"type","args":"0x..."}

# --- Optional timing overrides (defaults come from TIMING_PROFILE, src/common/constants/timing.constants.ts)
# Blocks kept free before LND auto-cancels a held HTLC (ln_to_fiber settles inside them).
# LN_MARGIN_BLOCKS=6
# CLTV blocks a Lightning payout (fiber_to_ln) may spend on route hops; the Fiber hold invoice is sized to fit them.
# LN_ROUTE_BUDGET_BLOCKS=80
# PAYER_MAX_CLTV=1008
# CLTV blocks kept free under PAYER_MAX_CLTV for the route between a payer and the hub (ln_to_fiber hold invoices):
# LDK's 80-block shadow-route reserve plus the hops. Profile defaults: 80 on regtest and mutinynet (an LDK payer needs a
# channel with the hub there), 80 + two 144-block LSP hops = 368 on testnet and mainnet.
# PAYER_ROUTE_BUDGET_BLOCKS=80
# FIBER_MARGIN_MINUTES=10
# FIBER_MAX_HOPS=1
# Longest one payout may lock the hub's funds (the user decides how long to hold it): caps the Fiber tlc_expiry_limit and
# the Lightning cltv_limit (at the profile's slow block interval); payout invoices that need longer are refused.
# Profile defaults: regtest 2880, mutinynet 720, testnet and mainnet 5760. Size OPTION_PREMIUM_BPS for this long.
# MAX_PAYOUT_LOCK_MINUTES=2880

# --- Hub LND (macaroon: info:read invoices:read invoices:write offchain:read offchain:write onchain:read)
LND_GRPC_HOST=127.0.0.1:10009
LND_TLS_CERT_PATH=./devnet/.secrets/lnd-hub/tls.cert
LND_MACAROON_PATH=./devnet/.secrets/lnd-hub/hub.macaroon
# or LND_TLS_CERT_BASE64=... / LND_MACAROON_HEX=...
# The hub LND's invoices.holdexpirydelta (lnd.conf): LND cancels an accepted hold invoice this many blocks before its
# earliest HTLC expires, and the hub sizes every ln_to_fiber payout to end before that point. It must equal lnd.conf;
# 18 (LND's default) or more.
LND_HOLD_EXPIRY_DELTA_BLOCKS=18

# --- Hub Fiber node
FIBER_RPC_URL=http://127.0.0.1:8227
# FIBER_RPC_TOKEN=
FIBER_PUBSUB=false
# How long one fnn JSON-RPC call may take, and the wait before reopening a closed pubsub WebSocket (all Fiber nodes).
FIBER_RPC_TIMEOUT_MS=10000
FIBER_PUBSUB_RECONNECT_MS=5000

# --- Hub Fiber node for other Fiber nodes (GET /v1/fiber/node, /v1/fiber/inbound-channels)
# Comma-separated multiaddrs other nodes dial the hub's fnn at; empty lists are allowed. P2P: native TCP for fnn and
# Fiber Studio, e.g. /ip4/203.0.113.7/tcp/8228. WS: WebSocket, the only kind a browser node (fiber-js) can dial, e.g.
# /ip4/127.0.0.1/tcp/8228/ws locally or /dns4/fiber.example.org/tcp/443/wss behind a TLS proxy. Add /p2p/<peer id> when
# the dialler needs it. Taken from here as they are, never from the node.
FIBER_PUBLIC_P2P_ADDRS=
FIBER_PUBLIC_WS_ADDRS=
# Inbound channels: the hub's fnn opens a private channel, funded from its own wallet, to a node connected to it, so that
# node can receive (ln_to_fiber). On, it needs an amount for at least one asset and at least one public address above.
# All inbound channels together hold at most the hub's free Fiber payout liquidity in the asset (its other channels).
FIBER_INBOUND_ENABLED=false
# What one inbound channel is funded with, in base units (1 CKB = 100000000 shannons; RUSD has 8 decimals). An asset
# without an amount (or with an empty one) is not offered; an amount for an asset the hub does not serve is refused. A
# CKB funding includes fnn's reserve of 99 CKB and must be at least 19900000000 (199 CKB): a node on fnn's defaults
# (a browser node, Fiber Studio) auto-accepts CKB from 100 CKB usable. fiber-js auto-accepts RUSD from 10 RUSD.
# With FIBER_ASSETS, a UDT's amount is its inboundAmount there, and FIBER_INBOUND_RUSD_AMOUNT must stay unset.
# FIBER_INBOUND_CKB_AMOUNT=50000000000
# FIBER_INBOUND_RUSD_AMOUNT=2000000000
# Inbound channels per client (the rate limits' client key), per node and in total in a sliding day, and open at once
# in total. One channel per asset: a node asking for CKB, RUSD and cWBTC in one run needs 3 per client and per node.
FIBER_INBOUND_MAX_PER_CLIENT_PER_DAY=2
FIBER_INBOUND_MAX_PER_NODE_PER_DAY=2
FIBER_INBOUND_MAX_PER_DAY=10
FIBER_INBOUND_MAX_OPEN=20
# How long the hub waits for a node to accept an inbound channel it opens before it gives the open up, in seconds.
FIBER_INBOUND_ACCEPT_TIMEOUT_SECONDS=600
# Channels nodes open to the hub's fnn with their own tokens (FIBER_ASSETS peerChannels): each locks about 180 CKB of
# the fnn wallet as its reserve. GET /v1/fiber/node stops offering them (peerChannels null for every asset) once nodes
# have this many open in all those UDTs together (any state but closed), or when the hub cannot read its node's
# channels; 0 never offers them. The cap only stops the offer: fnn 0.9.1 has no count limit, so fnn still auto-accepts
# a channel any fnn client opens with at least minAmount.
FIBER_PEER_CHANNELS_MAX_OPEN=10

# --- Health check: how long each node gets to answer before GET /v1/health reports it unreachable
HEALTH_CHECK_TIMEOUT_MS=5000

# --- Demo wallet (hub-run nodes for visitors without their own)
DEMO_ENABLED=false
DEMO_MAX_ACTIONS_PER_HOUR=60
# Demo-wallet actions per hour of every client together, on top of the per-client budget above.
DEMO_MAX_ACTIONS_PER_HOUR_TOTAL=600
# Lifetime a demo payout invoice gets on top of QUOTE_TTL_SECONDS, so it is still payable at the end of the swap.
DEMO_PAYOUT_INVOICE_EXTRA_SECONDS=3600
# DEMO_LND_GRPC_HOST=127.0.0.1:10010
# DEMO_LND_TLS_CERT_PATH=./devnet/.secrets/lnd-user/tls.cert
# DEMO_LND_MACAROON_PATH=./devnet/.secrets/lnd-user/demo.macaroon
# or DEMO_LND_TLS_CERT_BASE64=... / DEMO_LND_MACAROON_HEX=...
# DEMO_FIBER_RPC_URL=http://127.0.0.1:8237
# DEMO_FIBER_RPC_TOKEN=

# --- Pricing
PRICE_SOURCES=coingecko,binance,kucoin
PRICE_HTTP_TIMEOUT_MS=5000
PRICE_MAX_AGE_SECONDS=600
# A fetched market price is reused this long (ms) and concurrent quotes share one fetch; 0 turns the cache off.
PRICE_CACHE_MS=15000
# Hub fee, option premium and the Lightning bounds of one swap; a UDT's own values in FIBER_ASSETS replace them for it.
FEE_BPS=50
OPTION_PREMIUM_BPS=50
QUOTE_TTL_SECONDS=180
SWAP_MIN_SATS=1000
SWAP_MAX_SATS=100000
# 32-byte hex Ed25519 seed that signs quotes. Leave empty to generate one per process.
# QUOTE_SIGNING_KEY=

# --- Swap execution
SWAP_POLL_INTERVAL_MS=2000
LN_PAY_TIMEOUT_SECONDS=60
# Routing fee limits of the payouts, basis points. Quotes also keep this much free on top of each payout. The payee can
# route its payout through a node of its own and collect the whole budget, so each must be below FEE_BPS.
LN_MAX_FEE_BPS=25
FIBER_MAX_FEE_BPS=25
# Most parts a Lightning payout may be split into (LND max_parts).
LN_MAX_PAYMENT_PARTS=16
# Put route hints for the hub LND's private channels in its hold invoices, so a payer can reach the hub over a channel
# that is not announced (e.g. a private channel with the payer's LSP).
LN_INVOICE_ROUTE_HINTS=false
FIBER_HOLD_FINAL_EXPIRY_DELTA_MINUTES=360
# A hold invoice expires with its quote, counted in whole seconds by the node's own clock. An unpaid one the node
# releases from this many seconds before the quote's expiry on counts as expired with the quote, not as cancelled
# behind the hub's back (which is logged as a warning).
HOLD_INVOICE_EXPIRY_TOLERANCE_SECONDS=5
# Commitment delay (epochs of 4 h) assumed for a Fiber channel a peer opened to the hub's fnn. The opener chooses it
# (fnn accepts 1 to 84) and fnn fails a held TLC 2/3 of it before expiry, but list_channels does not show it: with the
# default, a payment that arrives over such a channel leaves no time for a payout and is refunded, unless its asset
# takes peer channels (FIBER_ASSETS peerChannels), whose hold invoices are sized for 84 epochs. Lower it only when the
# hub's fnn accepts no channel with a longer delay (auto-accept off, channels reviewed); the hub refuses to start with it
# lowered while any asset has peerChannels. The hub's own channels must use fnn's default of 1 epoch.
FIBER_PEER_CHANNEL_COMMITMENT_DELAY_EPOCHS=84
# A payout the paying node has no record of (a crash right after saving it, or a send whose answer was lost) is sent
# again at most this many times while the held payment still allows it.
PAYOUT_MAX_RESENDS=3
# The hub refunds such a payout only once it has stayed unknown to the node this long after its last send, since a send
# whose call timed out can still be starting inside the node. At least FIBER_RPC_TIMEOUT_MS (checked at start-up).
PAYOUT_MISSING_CONFIRM_SECONDS=30
# Swaps waiting for their payment, per client (the rate limits' client key) and in total. Each reserves its payout and
# leaves a hold invoice on the hub's nodes until its quote expires; past a cap POST /v1/swaps answers 429 rate_limited.
SWAP_MAX_UNPAID_PER_CLIENT=5
SWAP_MAX_UNPAID=50
