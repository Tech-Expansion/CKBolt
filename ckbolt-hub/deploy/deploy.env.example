# Settings of the deploy scripts (npm --prefix deploy run testnet / testnet:check / testnet:smoke), read on THIS machine.
# Copy to deploy/deploy.env (git ignores it). Variables already set in the environment win over the file. Every line
# below shows the default; only DEPLOY_SSH_HOST is required. The server's own settings live in the kit's .env and
# hub.env on the server (deploy/testnet/.env.example, hub.env.example).

# --- Server
# Host or ~/.ssh/config alias. ssh must log in without a password prompt (key or agent): the scripts use BatchMode.
DEPLOY_SSH_HOST=
DEPLOY_SSH_CONNECT_TIMEOUT_SECONDS=15
# The kit folder on the server (absolute, plain names only: the scripts replace its src/ folder).
DEPLOY_REMOTE_DIR=/opt/ckbolt/testnet
# The server's public IPv4 address for the kit's PUBLIC_IP. Empty: the address ssh connects to (ssh -G).
DEPLOY_PUBLIC_IP=

# --- Timeouts
# One remote command; image builds, `up` and `compose --` passes; waits for nodes and channels; HTTP calls.
DEPLOY_COMMAND_TIMEOUT_SECONDS=300
DEPLOY_BUILD_TIMEOUT_SECONDS=3600
DEPLOY_WAIT_TIMEOUT_SECONDS=1800
# How long a node gets to connect to a peer it dialled (Fiber relays, fnn-demo to fnn-hub).
DEPLOY_PEER_CONNECT_TIMEOUT_SECONDS=120
DEPLOY_POLL_INTERVAL_SECONDS=10
DEPLOY_HTTP_TIMEOUT_SECONDS=30

# --- Public services (defaults: the live test networks of October 2026)
DEPLOY_MUTINYNET_FAUCET_URL=https://faucet.mutinynet.com
DEPLOY_CKB_FAUCET_API_URL=https://faucet-api.nervos.org
# Public CKB testnet RPC with the indexer, read from this machine (how much CKB each fnn wallet holds).
DEPLOY_CKB_RPC_URL=https://testnet.ckbapp.dev/
# The LSP Alby Hub wallets on Mutinynet get their channels from (Megalith): lnd-hub opens a private channel to it, so
# payouts reach those wallets in one hop, and LND payers find the hub through its route hint (LN_INVOICE_ROUTE_HINTS in
# hub.env). An Alby Hub (LDK) payer still needs a channel of its own with lnd-hub (README, section 8).
DEPLOY_LN_LSP_NODE=03e30fda71887a916ef5548a4d02b06fe04aaa1a8de9e24134ce7f139cf79d7579@64.23.192.68:9736
# Fiber relay nodes fnn-hub opens public channels to, <pubkey>@<multiaddr>, comma-separated (bottle and bracer).
DEPLOY_FIBER_RELAYS=02b6d4e3ab86a2ca2fad6fae0ecb2e1e559e0b911939872a90abdda6d20302be71@/dns4/bottle.fiber.channel/tcp/8119/p2p/QmXen3eUHhywmutEzydCsW4hXBoeVmdET2FJvMX69XJ1Eo,0291a6576bd5a94bd74b27080a48340875338fff9f6d6361fe6b8db8d0d1912fcc@/dns4/bracer.fiber.channel/tcp/8119/p2p/QmbKyzq9qUmymW2Gi8Zq7kKVpPiNA1XUJ6uMvsUC4F3p89

# --- CKB faucet claims (`testnet fund`): whole CKB per claim (10000 or 100000; 300,000 per address per month), made
# only while the node's wallet holds less than the minimum.
DEPLOY_CKB_CLAIM_HUB=100000
DEPLOY_CKB_CLAIM_DEMO=10000
DEPLOY_CKB_MIN_HUB=25000
DEPLOY_CKB_MIN_DEMO=1000

# --- Lightning amounts, sats. One day of the Mutinynet faucet is 1,000,000 sats (on-chain, channels and Lightning
# together): LSP channel + demo wallet + reserve must fit in it.
# lnd-hub's private channel to the LSP, and the part of it pushed to the LSP's side at opening: the hub's inbound,
# which wallets behind the LSP pay the hub with (BTC to CKB swaps). The push must be below the channel.
DEPLOY_LN_LSP_CHANNEL_SATS=220000
DEPLOY_LN_LSP_PUSH_SATS=100000
# Sent from lnd-hub to lnd-demo (demo profile), and lnd-demo's channel to lnd-hub (it pays the hub in testnet:smoke).
DEPLOY_LN_DEMO_WALLET_SATS=200000
DEPLOY_LN_DEMO_CHANNEL_SATS=150000
# `testnet balance` pays faucet invoices through the LSP until lnd-hub's channel to it holds this much inbound again
# (below the channel's size; the default is the push).
DEPLOY_LN_INBOUND_TARGET_SATS=100000
DEPLOY_LN_BALANCE_INVOICE_SATS=50000
DEPLOY_LN_BALANCE_MAX_INVOICES=10
# Left in each LND wallet for on-chain fees.
DEPLOY_LN_ONCHAIN_RESERVE_SATS=20000
DEPLOY_LN_PAY_TIMEOUT_SECONDS=120
DEPLOY_LN_PAY_FEE_LIMIT_SATS=100

# --- Fiber channels (`testnet channels`), whole CKB or RUSD. RUSD needs the hand step (JoyID) first; 0 skips it.
DEPLOY_FIBER_RELAY_CHANNEL_CKB=1000
DEPLOY_FIBER_RELAY_CHANNEL_RUSD=0
DEPLOY_FIBER_DEMO_CHANNEL_CKB=20000
DEPLOY_FIBER_DEMO_CHANNEL_RUSD=0
# Share of each demo channel moved to fnn-demo so it can pay as well as receive, basis points.
DEPLOY_FIBER_DEMO_SHARE_BPS=5000
DEPLOY_FIBER_INVOICE_EXPIRY_SECONDS=3600
DEPLOY_FIBER_PAYMENT_ATTEMPTS=5

# --- testnet:smoke (each also a command-line option: --direction, --asset, --sats)
DEPLOY_SMOKE_SATS=2000
DEPLOY_SMOKE_ASSET=CKB
DEPLOY_SMOKE_DIRECTION=both
DEPLOY_SMOKE_TIMEOUT_SECONDS=600

# --- testnet:check: a channel or payout side below this many sats is a warning (SWAP_MAX_SATS in hub.env).
DEPLOY_CHECK_MIN_LIQUIDITY_SATS=20000
