# CKBolt hub settings on test networks (Mutinynet + CKB testnet). `npm --prefix deploy run testnet -- env` copies this
# file to hub.env on the server when there is none, and appends any key a newer kit adds; it never changes a value.
# Variables not listed keep the defaults of the hub's .env.example (src/config/hub.config.ts).
# Set by docker-compose.yml from .env, so not repeated here: QUOTE_SIGNING_KEY, DEMO_ENABLED,
# LND_HOLD_EXPIRY_DELTA_BLOCKS (the same variable as LND's invoices.holdexpirydelta) and, on a server with a public IP,
# FIBER_PUBLIC_P2P_ADDRS and FIBER_PUBLIC_WS_ADDRS (docker-compose.public.yml).

# --- HTTP server. Inside the container; Compose publishes 8787 on 127.0.0.1:${HUB_HOST_PORT} only.
HUB_HOST=0.0.0.0
HUB_PORT=8787
# Browsers reach the hub only through the web app's same-origin proxy (/api/hub), so no CORS origin is needed.
HUB_CORS_ORIGINS=
# false while the operator reaches the hub through an SSH tunnel (one client). Set true once a public web server with
# TRUST_PROXY=1 runs in front of the hub, so each visitor counts as its own client (deploy/README.md, "Public web app").
HUB_TRUST_PROXY=false
HUB_DB_PATH=/data/hub.sqlite

# --- Client limits (defaults shown). Requests per client per minute, and how many clients each limit tracks at once.
HUB_RATE_LIMIT_PER_MINUTE=120
HUB_RATE_LIMIT_MAX_CLIENTS=10000
# Swaps waiting for their payment, per client and for every client together. Each reserves its payout and leaves a hold
# invoice on the hub's nodes until its quote expires; past a cap POST /v1/swaps answers 429 rate_limited.
SWAP_MAX_UNPAID_PER_CLIENT=5
SWAP_MAX_UNPAID=50
# Largest swap. Kept low until the channels hold more: 20,000 sats is about 10,800 CKB or 16 RUSD (October 2026).
SWAP_MAX_SATS=20000
# lnd-hub has a private channel with Megalith, the LSP of Alby Hub wallets on Mutinynet: payouts reach them through it,
# and the hold invoices carry a route hint for it (LND payers can pay through it). An LDK payer such as Alby Hub cannot:
# 851+ hold blocks plus LDK's 80-block reserve leave no room for a hop, so it needs a channel with lnd-hub.
LN_INVOICE_ROUTE_HINTS=true

# --- Networks: Mutinynet is a signet (lntbs invoices) with 30 s blocks; Fiber invoices on CKB testnet are fibt.
BTC_NETWORK=signet
TIMING_PROFILE=mutinynet
CKB_NETWORK=testnet
# Without FIBER_ASSETS the hub serves CKB and RUSD (Fiber's testnet whitelist script, TESTNET_RUSD_TYPE_SCRIPT), as
# before. FIBER_ASSETS lists the UDTs instead, each with its own terms (src/config/fiber-assets.config.ts): the line
# below adds cWBTC (CCH Wrapped BTC, 1:1 with BTC, no option premium) next to RUSD. To use it: remove
# FIBER_INBOUND_RUSD_AMOUNT (RUSD's inboundAmount replaces it; the hub refuses both), uncomment the line, then
# `python3 add_token.py --regenerate --apply` in the kit folder (it generates fnn/hub.yml and fnn/demo.yml's
# udt_whitelist from FIBER_ASSETS and restarts fnn where it changed), then `docker compose up -d hub` so the hub reads the
# edited hub.env (a restart would not). Later tokens: add_token.py with a
# token file (docs/add-token.md); an entry may set peerChannels so nodes can open their own channel to the hub in it.
# Paying out cWBTC needs cWBTC in fnn-hub's channels (faucet: https://faucet-cwbtc.ckb.dev), and each UDT channel fnn-hub
# is part of, inbound and peer channels included, locks about 180 CKB of fnn-hub's on-chain wallet as its reserve.
# FIBER_ASSETS='[{"id":"RUSD","symbol":"RUSD","name":"RUSD stablecoin","decimals":8,"usdRule":"usd_peg","typeScript":{"codeHash":"0x1142755a044bf2ee358cba9f2da187ce928c91cd4dc8692ded0337efa677d21a","hashType":"type","args":"0x878fcc6f1f08d48e87bb1c3b3d5083f23f8a39c5d5c764f253b55b998526439b"},"cellDeps":[{"typeId":{"codeHash":"0x00000000000000000000000000000000000000000000000000545950455f4944","hashType":"type","args":"0x97d30b723c0b2c66e9cb8d4d0df4ab5d7222cbb00d4a9a2055ce2e5d7f0d8b0f"}}],"inboundAmount":"2000000000","autoAcceptAmount":"1000000000"},{"id":"CWBTC","symbol":"cWBTC","name":"CCH Wrapped BTC","decimals":8,"usdRule":"btc_parity","typeScript":{"codeHash":"0x25c29dc317811a6f6f3985a7a9ebc4838bd388d19d0feeecf0bcd60f6c0975bb","hashType":"type","args":"0x9a1086531ed6dc69e0bd44cef5278e03faf3015b31aff60b08fb87663ce8507100000000"},"cellDeps":[{"outPoint":{"txHash":"0xbf6fb538763efec2a70a6a3dcb7242787087e1030c4e7d86585bc63a9d337f5f","index":"0x0"},"depType":"code"}],"optionPremiumBps":0,"inboundAmount":"1000000000","autoAcceptAmount":"1000000000"}]'

# --- Hub LND (lnd-hub): least-privilege macaroon from `testnet macaroons`.
LND_GRPC_HOST=lnd-hub:10009
LND_TLS_CERT_PATH=/secrets/lnd-hub/tls.cert
LND_MACAROON_PATH=/secrets/lnd-hub/hub.macaroon

# --- Hub Fiber node (fnn-hub), on the same Docker network: no Biscuit token. Set FIBER_RPC_TOKEN when the hub reaches
# fnn over a network address that needs one (deploy/README.md, "Biscuit").
FIBER_RPC_URL=http://fnn-hub:8227
FIBER_PUBSUB=true

# --- Inbound channels for browser Fiber nodes (POST /v1/fiber/inbound-channels): fnn-hub opens a channel to a node
# connected to it, so that node can receive. Amounts are base units (10^8 per CKB or RUSD); an asset without an amount
# gets no inbound channels (leave the line commented out: an empty value is refused). With FIBER_ASSETS a UDT's amount
# is its inboundAmount there. Each channel locks the hub's own
# CKB (or RUSD) until it closes: size the caps to the hub's wallet. Needs the public overlay (FIBER_PUBLIC_*_ADDRS).
FIBER_INBOUND_ENABLED=true
# 2,000 CKB per channel.
FIBER_INBOUND_CKB_AMOUNT=200000000000
# FIBER_INBOUND_RUSD_AMOUNT=2000000000
FIBER_INBOUND_MAX_PER_CLIENT_PER_DAY=3
# Two a day: a node can close its channel and ask again with more CKB of its own in it.
FIBER_INBOUND_MAX_PER_NODE_PER_DAY=2
FIBER_INBOUND_MAX_OPEN=10
# Channels nodes open to fnn-hub with their own tokens (FIBER_ASSETS peerChannels; each locks about 180 CKB of fnn-hub's
# wallet): GET /v1/fiber/node stops offering them once this many are open, every such UDT together. fnn-hub still
# auto-accepts a channel opened directly over fnn's RPC with at least minAmount (fnn 0.9.1 has no count limit).
FIBER_PEER_CHANNELS_MAX_OPEN=10

# --- Payouts the paying node has no record of (a crash right after saving one, or a send whose answer was lost): sent
# again at most PAYOUT_MAX_RESENDS times, and refunded only once unknown for PAYOUT_MISSING_CONFIRM_SECONDS after the
# last send (at least FIBER_RPC_TIMEOUT_MS, 10000 by default; checked at start-up).
PAYOUT_MAX_RESENDS=3
PAYOUT_MISSING_CONFIRM_SECONDS=30

# --- Demo wallet (lnd-demo, fnn-demo; on with DEMO_ENABLED=true and COMPOSE_PROFILES=demo in .env): custodial test
# money, rate limited per client and for every client together.
DEMO_MAX_ACTIONS_PER_HOUR=60
DEMO_MAX_ACTIONS_PER_HOUR_TOTAL=600
DEMO_LND_GRPC_HOST=lnd-demo:10009
DEMO_LND_TLS_CERT_PATH=/secrets/lnd-demo/tls.cert
DEMO_LND_MACAROON_PATH=/secrets/lnd-demo/demo.macaroon
DEMO_FIBER_RPC_URL=http://fnn-demo:8227
