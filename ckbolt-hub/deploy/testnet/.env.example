# Compose variables for deploy/testnet (Compose reads .env next to docker-compose.yml). It holds secrets: mode 600,
# never in git. `npm --prefix deploy run testnet -- env` creates or completes it on the server: it keeps every value
# already there (the bitcoind RPC credentials of a running sync included), generates each missing secret on the server
# (it never leaves it and is never printed), fills in PUBLIC_IP and copies the other missing keys from this file.
# The hub's own settings are in hub.env.

# --- Compose files and profiles. A server with a public IP uses the public overlay; drop it on a machine without one.
COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# "demo" also runs lnd-demo and fnn-demo (the demo wallet's nodes; testnet:smoke pays and receives with them).
# "tunnel" also runs cloudflared and fiber-ws (the public HTTPS API and WSS for browser nodes; needs the token below).
# Both: COMPOSE_PROFILES=demo,tunnel
COMPOSE_PROFILES=
# true: the hub offers the demo wallet (custodial test money). Needs COMPOSE_PROFILES=demo.
DEMO_ENABLED=false

# --- Secrets: generated by `testnet env` when missing or empty (hex from /dev/urandom on the server).
# Ed25519 seed (32 bytes hex) that signs the hub's quotes: quotes keep verifying across restarts. Keep a copy offline.
QUOTE_SIGNING_KEY=
# bitcoind RPC password, used by both LND nodes. Kept as it is when the running sync already set it.
BITCOIND_RPC_PASSWORD=
# Passwords that encrypt each fnn node's CKB wallet key in its volume. Losing one loses that node's wallet.
FNN_HUB_KEY_PASSWORD=
FNN_DEMO_KEY_PASSWORD=

# --- Public IPv4 address of the server, announced by lnd-hub and fnn-hub (docker-compose.public.yml). `testnet env`
# takes it from DEPLOY_PUBLIC_IP or the SSH host's address.
PUBLIC_IP=

# --- Image builds: the hub source `testnet sync` uploads next to the kit (src/). From a hub checkout instead, leave
# both empty and Compose uses the repository (../.. and ../../devnet/fnn).
HUB_BUILD_CONTEXT=./src
FNN_BUILD_CONTEXT=./src/devnet/fnn

# --- Optional
BITCOIND_RPC_USER=ckbolt
# bitcoind chainstate cache, MB. 1000 or more speeds up a first sync if the server has the memory.
BITCOIND_DBCACHE_MB=450
# LND's invoices.holdexpirydelta and the hub's LND_HOLD_EXPIRY_DELTA_BLOCKS together (18, LND's default, or more).
LND_HOLD_EXPIRY_DELTA_BLOCKS=18
# CKB testnet RPC that both fnn nodes use: the public endpoint, or your own CKB testnet node.
CKB_RPC_URL=https://testnet.ckbapp.dev/
LND_VERSION=v0.21.4-beta
LND_HUB_ALIAS=ckbolt-hub
LND_DEMO_ALIAS=ckbolt-demo-wallet
FNN_HUB_NODE_NAME=ckbolt-hub
FNN_DEMO_NODE_NAME=ckbolt-demo-wallet
FNN_LOG=info
HUB_IMAGE_TAG=local
# Host ports. The two P2P ports are public (docker-compose.public.yml); the hub binds to 127.0.0.1 only.
LND_HUB_P2P_PORT=9735
FNN_HUB_P2P_PORT=8228
HUB_HOST_PORT=18787
# What GET /v1/fiber/node tells browser Fiber nodes to dial, comma-separated multiaddrs. Empty: built from PUBLIC_IP
# and FNN_HUB_P2P_PORT (docker-compose.public.yml). Set a /dns4/<name>/tcp/443/wss address once a TLS proxy exists.
FIBER_PUBLIC_P2P_ADDRS=
FIBER_PUBLIC_WS_ADDRS=

# --- Cloudflare Tunnel (profile `tunnel`; deploy/README.md section 10). The token from Cloudflare (Zero Trust, Networks,
# Tunnels), set by hand on the server and never in git; the scripts never read it back.
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.8.2
SOCAT_VERSION=1.8.0.3
