{
  "name": "ckbolt-deploy",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy kit for the CKBolt hub on test networks: drives deploy/testnet on a server over SSH, from Windows or Linux.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "testnet": "ts-node --transpile-only scripts/testnet.ts",
    "testnet:check": "ts-node --transpile-only scripts/check.ts",
    "testnet:smoke": "ts-node --transpile-only scripts/smoke.ts",
    "test": "node --require ts-node/register/transpile-only --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
